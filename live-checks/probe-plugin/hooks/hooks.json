{
  "hooks": {
    "PreToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/log-hook.mjs" } ] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/log-hook.mjs" } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/log-hook.mjs" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/log-hook.mjs" } ] }
    ]
  }
}
